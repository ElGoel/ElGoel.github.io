---
import Navbar from '../components/Navbar.astro';
import SocialIcons from '../components/SocialIcons.astro';
import '../styles/global.css';
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/png' href='/favicon.svg' />
    <link
      href='https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css'
      rel='stylesheet'
    />
    <title>Angelo — Portfolio</title>
  </head>
  <body class='bg-gray-950 text-gray-100'>
    <Navbar />

    <main
      id='main-viewport'
      class='relative z-10 w-screen h-screen overflow-x-hidden overflow-y-hidden'
    >
      <div
        id='main-scroll'
        class='flex h-screen overflow-x-scroll snap-x snap-mandatory scroll-smooth no-scrollbar'
      >
        <slot />
      </div>
      <SocialIcons />
      <h1
        class='fixed bottom-16 left-2/4 text-3xl text-grey-400'
        id='pagination'
      >
      </h1>
    </main>
    <script>
      (function () {
        const isRoot =
          location.pathname === '/' ||
          location.pathname === '' ||
          location.pathname === '/index.html';

        if (isRoot) {
          document.addEventListener('click', (e) => {
            const el = e.target.closest('a[data-section]');
            if (!el) return;
            e.preventDefault();
            const sectionId = el.dataset.section;
            const target = document.getElementById(sectionId);
            if (target) {
              target.scrollIntoView({
                behavior: 'smooth',
                inline: 'start',
                block: 'nearest'
              });
              history.replaceState(null, '', `/`);
            }
          });
        }

        function scrollToHashIfPresent() {
          const hash = (location.hash || '').replace('#', '');
          if (!hash) return;
          const el = document.getElementById(hash);
          if (el) {
            setTimeout(() => {
              el.scrollIntoView({
                behavior: 'smooth',
                inline: 'start',
                block: 'nearest'
              });
              history.replaceState(null, '', `/`);
            }, 120);
          }
        }

        function observeSections() {
          const viewportRoot = document.getElementById('main-viewport');
          if (!viewportRoot) return;

          const activeClasses = [
            'bg-primary-500',
            'text-font-dark',
            'dark:text-white',
            'dark:bg-primary-500',
            'font-bold'
          ];
          const inactiveClasses = ['text-gray-300', 'dark:text-gray-500'];

          const sections = document.querySelectorAll(
            '#home, #about, #projects'
          );

          if (sections.length === 0) return;

          const observerOptions = {
            root: viewportRoot,
            rootMargin: '0px',
            threshold: 0.5
          };

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const id = entry.target.id;
              const index = Array.from(sections).indexOf(entry.target) + 1;
              const link = document.querySelector(`a[data-section="${id}"]`);
              const pagination = document.getElementById(`pagination`);
              if (link) {
                if (entry.isIntersecting) {
                  link.classList.add(...activeClasses);
                  link.classList.remove(...inactiveClasses);
                  if (pagination) {
                    pagination.textContent = `0${index}`;
                  }
                } else {
                  link.classList.remove(...activeClasses);
                  link.classList.add(...inactiveClasses);
                }
              }
            });
          }, observerOptions);

          sections.forEach((section) => {
            observer.observe(section);
          });
        }

        if (
          document.readyState === 'complete' ||
          document.readyState === 'interactive'
        ) {
          scrollToHashIfPresent();
          observeSections();
        } else {
          document.addEventListener('DOMContentLoaded', () => {
            scrollToHashIfPresent();
            observeSections();
          });
        }

        window.addEventListener('hashchange', scrollToHashIfPresent);
      })();
    </script>
    <script>
      (function () {
        const container = document.getElementById('main-scroll');
        const sections = Array.from(
          document.querySelectorAll('#home, #about, #projects')
        );
        if (!container || sections.length === 0) return;

        let currentIndex = 0;
        let isScrolling = false;
        const SCROLL_LOCK_TIME = 700;

        function scrollToSection(index) {
          if (index < 0 || index >= sections.length) return;

          isScrolling = true;
          currentIndex = index;

          sections[index].scrollIntoView({
            behavior: 'smooth',
            inline: 'start',
            block: 'nearest'
          });

          setTimeout(() => (isScrolling = false), SCROLL_LOCK_TIME);
        }

        window.addEventListener(
          'wheel',
          (e) => {
            if (isScrolling) return;
            e.preventDefault();

            if (e.deltaY > 0) {
              scrollToSection(currentIndex + 1);
            } else if (e.deltaY < 0) {
              scrollToSection(currentIndex - 1);
            }
          },
          { passive: false }
        );

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                currentIndex = sections.indexOf(entry.target);
              }
            });
          },
          { threshold: 0.6 }
        );
        sections.forEach((s) => observer.observe(s));

        const btn = document.getElementById('next-section-btn');
        btn.addEventListener('click', () => {
          scrollToSection(currentIndex + 1);
        });
      })();
    </script>
  </body>
</html>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
